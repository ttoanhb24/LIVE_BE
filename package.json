{
  "name": "talentmanagment-be",
  "version": "0.0.1",
  "private": true,
  "description": "Talent Management backend (NestJS)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "assistant:sync-knowledge": "ts-node scripts/generate-assistant-knowledge.ts",
    "assistant:test-prompt": "ts-node scripts/test-assistant-prompt.ts",
    "prisma:studio": "prisma studio",
    "import:users-csv-overwrite": "node scripts/overwrite-users-from-csv.js",
    "import:users-hs-xlsx": "node scripts/import-hs-chuan-xlsx.js",
    "db:list-users": "node scripts/list-users.js",
    "db:normalize-emails": "node scripts/normalize-user-emails.js",
    "db:add-cultural-vanhoa-round2": "node --env-file=.env scripts/add-cultural-vanhoa-round2-members.js",
    "db:add-van78-dot2-unified-class": "node --env-file=.env scripts/add-van78-dot2-unified-class-members.js",
    "db:backfill-org-from-legacy-text": "node scripts/backfill-org-membership-from-legacy-text.js",
    "prisma:seed": "ts-node scripts/seed.ts",
    "prisma:seed:dry": "prisma db seed -- --dry-run",
    "seed:staff": "ts-node scripts/seed-staff.ts"
  },
  "prisma": {
    "seed": "ts-node scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.106.0",
    "@types/compression": "^1.8.1",
    "@types/pg": "^8.20.0",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.2.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "mammoth": "^1.12.0",
    "nodemailer": "^8.0.5",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.63.0",
    "xlsx": "^0.18.5"
  }
}
